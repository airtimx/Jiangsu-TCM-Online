// 模块 02 小程序 API 配置
export const API_BASE = 'http://127.0.0.1:8081'

export function getToken(): string {
  return uni.getStorageSync('tcm_app_token') || ''
}

export function setToken(token: string) {
  uni.setStorageSync('tcm_app_token', token)
}

export function clearToken() {
  uni.removeStorageSync('tcm_app_token')
}

export function request<T>(options: {
  url: string
  method?: 'GET' | 'POST' | 'PUT' | 'DELETE'
  data?: UTSJSONObject
}): Promise<T> {
  return new Promise((resolve, reject) => {
    uni.request({
      url: `${API_BASE}${options.url}`,
      method: options.method ?? 'GET',
      data: options.data,
      header: {
        Authorization: getToken() ? `Bearer ${getToken()}` : '',
        'Content-Type': 'application/json',
      },
      success: (res) => {
        const body = res.data as UTSJSONObject
        const code = body['code'] as number
        if (code != 0) {
          reject(new Error((body['message'] as string) ?? '请求失败'))
          return
        }
        resolve(body['data'] as T)
      },
      fail: (err) => reject(err),
    })
  })
}
