<template>
  <view class="page">
    <text class="title">微信登录（Mock）</text>
    <button type="primary" @click="onLogin">模拟 code 登录</button>
    <text class="hint">开发环境 code 任意，后端 mock 模式生成 openid</text>
  </view>
</template>

<script setup lang="uts">
import { request, setToken } from '../../common/request.uts'

async function onLogin() {
  try {
    const data = await request<UTSJSONObject>({
      url: '/api/app/v1/auth/wx-login',
      method: 'POST',
      data: { code: 'dev-user-001' } as UTSJSONObject,
    })
    const token = data['accessToken'] as string
    setToken(token)
    uni.showToast({ title: '登录成功' })
    uni.navigateBack()
  } catch (e) {
    uni.showToast({ title: '登录失败', icon: 'none' })
  }
}
</script>

<style>
.page { padding: 40px 24px; }
.title { display: block; font-size: 18px; margin-bottom: 24px; }
.hint { display: block; margin-top: 16px; color: #909399; font-size: 13px; }
</style>
